#!/usr/bin/env bash
set -e

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/macaron"
SERVICES_DIR="$CONFIG_DIR/services"

run_check() {
  if [ -x "$1" ]; then
    "$1"
  else
    bash "$1"
  fi
}

usage() {
  cat <<EOF
Usage:
  macaron [start]
  macaron doctor
  macaron install [options] <repository>
  macaron update
  macaron delete <service>
  macaron help
EOF
}

install_usage() {
  cat <<EOF
Usage: macaron install [options] <repository>

Options:
  --name <name>       Name of the service directory
  --branch <branch>   Clone a specific branch
  --skip-build        Do not run the service build script
  --skip-doctor       Do not run the service doctor
  -y, --yes           Automatically confirm the build script
  -h, --help          Show this help
EOF
}

doctor() {
  local failed=0
  local found=0
  local service_dir
  local service_check

  if ! command -v tailscale >/dev/null 2>&1; then
    echo "😵 Tailscale: not installed or not on PATH"
    failed=1
  elif tailscale status >/dev/null 2>&1; then
    echo "✅ Tailscale: running"
  else
    echo "😵 Tailscale: stopped or needs login"
    failed=1
  fi

  echo
  echo "🔍 Checking services..."
  if [ ! -d "$SERVICES_DIR" ]; then
    echo "  - no services configured ($SERVICES_DIR)"
  else
    for service_dir in "$SERVICES_DIR"/*; do
      [ -d "$service_dir" ] || continue
      service_check="$service_dir/.macaron/doctor"
      [ -f "$service_check" ] || continue
      found=1

      if run_check "$service_check"; then
        echo "  - $(basename "$service_dir"): ok"
      else
        echo "  - $(basename "$service_dir"): not ok"
        failed=1
      fi
    done
  fi

  if [ "$found" -eq 0 ] && [ -d "$SERVICES_DIR" ]; then
    echo "  - no service checks found"
  fi

  if [ "$failed" -eq 0 ]; then
    echo
    echo "✅ Doctor: all checks passed"
  else
    echo
    echo "😵 Doctor: one or more checks failed"
  fi

  return "$failed"
}

install() {
  local repo=""
  local name=""
  local branch=""
  local skip_build=0
  local skip_doctor=0
  local yes=0
  local arg

  while [ "$#" -gt 0 ]; do
    arg=$1
    case "$arg" in
      --name)
        [ "$#" -ge 2 ] || { echo "Missing value for --name" >&2; install_usage >&2; return 2; }
        name=$2
        shift 2
        ;;
      --branch)
        [ "$#" -ge 2 ] || { echo "Missing value for --branch" >&2; install_usage >&2; return 2; }
        branch=$2
        shift 2
        ;;
      --skip-build)
        skip_build=1
        shift
        ;;
      --skip-doctor)
        skip_doctor=1
        shift
        ;;
      -y|--yes)
        yes=1
        shift
        ;;
      -h|--help)
        install_usage
        return 0
        ;;
      --)
        shift
        [ "$#" -gt 0 ] || { echo "Missing repository" >&2; install_usage >&2; return 2; }
        repo=$1
        shift
        ;;
      -* )
        echo "Unknown install option: $arg" >&2
        install_usage >&2
        return 2
        ;;
      *)
        [ -z "$repo" ] || { echo "Only one repository can be installed at a time" >&2; install_usage >&2; return 2; }
        repo=$arg
        shift
        ;;
    esac
  done

  [ -n "$repo" ] || { echo "Missing repository" >&2; install_usage >&2; return 2; }

  if [ -z "$name" ]; then
    name=$(basename "$repo")
    name="${name%.git}"
  fi

  echo "📦 Installing from $repo..."

  # If NAME starts with macaron-service- , strip it off
  if [[ "$name" == macaron-service-* ]]; then
    name="${name#macaron-service-}"
    echo "ℹ️  Stripped macaron-service- prefix from name"
  fi

  mkdir -p "$SERVICES_DIR"
  if [ -n "$branch" ]; then
    git clone --branch "$branch" "$repo" "$SERVICES_DIR/$name"
  else
    git clone "$repo" "$SERVICES_DIR/$name"
  fi

  # If the service has a .macaron/build script, run it (after confirmation)
  if [ "$skip_build" -eq 0 ]; then
    if [ -f "$SERVICES_DIR/$name/.macaron/build" ]; then
      if [ "$yes" -eq 1 ]; then
        echo "ℹ️  Running build script for $name (--yes)"
        bash "$SERVICES_DIR/$name/.macaron/build"
      else
        echo -n "ℹ️  $name has a build script. Run it? [y/N] "
        read -r answer
        if [[ "$answer" == [Yy]* ]]; then
          bash "$SERVICES_DIR/$name/.macaron/build"
        else
          echo "ℹ️  Skipping build script, the service may not work correctly without it"
        fi
      fi
    fi
  else
    echo "ℹ️  Skipping build script"
  fi

  # After the build script, run the doctor if the service has one
  if [ "$skip_doctor" -eq 0 ]; then
    if [ -f "$SERVICES_DIR/$name/.macaron/doctor" ]; then
      if run_check "$SERVICES_DIR/$name/.macaron/doctor"; then
        echo "ℹ️  Doctor passed"
      else
        echo "😵 Doctor failed, you can run it manually with 'macaron doctor'"
      fi
    fi
  else
    echo "ℹ️  Skipping doctor"
  fi

  echo "✅ Installed from $repo"
}

delete() {
  [ "$#" -eq 1 ] || { echo "Usage: macaron delete <service>" >&2; return 2; }
  NAME=$(basename "$1")
  echo "ℹ️  Deleting..."
  if [ -d "$SERVICES_DIR/$NAME" ]; then
    echo "ℹ️  Service directory exists, deleting..."
    rm -rf "$SERVICES_DIR/$NAME"
    echo "✅ Deleted"
  else
    echo "ℹ️  Service directory does not exist, nothing to delete"
  fi
}

update() {
  echo "🔄 Updating..."
  for service_dir in "$SERVICES_DIR"/*; do
    if [ -d "$service_dir" ]; then
      cd "$service_dir"
      git pull &>/dev/null
      echo "✅ $(basename "$service_dir") updated ($(git rev-parse --short HEAD))"
    fi
  done
  echo "✅ Update complete"
}

start() {
  sudo -v

  OLD_REMOTE_LOGIN=$(sudo systemsetup -getremotelogin | awk '{print tolower($3)}')
  if pmset -g | grep -q 'SleepDisabled.*1'; then
    OLD_DISABLE_SLEEP=1
  else
    OLD_DISABLE_SLEEP=0
  fi

  if tailscale status >/dev/null 2>&1; then
    OLD_TAILSCALE_RUNNING=1
  else
    OLD_TAILSCALE_RUNNING=0
  fi

  cleanup() {
    echo
    echo "🔙 Restoring previous settings..."

    sudo systemsetup -setremotelogin "$OLD_REMOTE_LOGIN" >/dev/null
    sudo pmset -a disablesleep "$OLD_DISABLE_SLEEP"

    if [ "$OLD_TAILSCALE_RUNNING" -eq 1 ]; then
      tailscale up
    else
      tailscale down
    fi
  }

  trap cleanup EXIT
  trap 'exit 0' INT TERM

  sudo systemsetup -setremotelogin on >/dev/null
  echo "✅ Remote Login enabled"
  sudo pmset -a disablesleep 1
  echo "✅ Sleep disabled"
  tailscale up
  echo "✅ Tailscale started"

  echo
  echo "🙈 Environment looks good! Now loading services"

  TAILSCALE_IP=$(tailscale ip -4 | head -n 1)
  PORT=49001
  LOGS=""
  FOUND_SERVICES=0

  if [ -d "$SERVICES_DIR" ]; then
    for SERVICE_DIR in "$SERVICES_DIR"/*; do
      [ -d "$SERVICE_DIR" ] || continue
      SERVICE_START="$SERVICE_DIR/.macaron/start"
      [ -f "$SERVICE_START" ] || continue
      FOUND_SERVICES=1

      SERVICE=$(basename "$SERVICE_DIR")
      if MACARON_AVAILABLE_PORT="$PORT" run_check "$SERVICE_START"; then
        echo "✅ $SERVICE started"
        LOGS="$LOGS   -> $SERVICE: http://$TAILSCALE_IP:$PORT\n"
      else
        echo "😵 Failed to start $SERVICE"
      fi
      PORT=$((PORT + 1))
    done
  fi

  if [ "$FOUND_SERVICES" -eq 0 ]; then
    echo "⚠️  No services found in $SERVICES_DIR"
  fi

  echo
  echo "🏃 Everything looks good! Macaron is running..."
  echo "   -> Connect via SSH: ssh $(whoami)@$TAILSCALE_IP"
  printf '%b' "$LOGS"

  while true; do
    sleep 3600
  done
}

COMMAND="${1:-start}"
[ "$#" -eq 0 ] || shift

case "$COMMAND" in
  doctor)
    [ "$#" -eq 0 ] || { echo "Usage: macaron doctor" >&2; exit 2; }
    doctor
    ;;
  install)
    install "$@"
    ;;
  update)
    [ "$#" -eq 0 ] || { echo "Usage: macaron update" >&2; exit 2; }
    update
    ;;
  delete)
    delete "$@"
    ;;
  start)
    [ "$#" -eq 0 ] || { echo "Usage: macaron start" >&2; exit 2; }
    start
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "Unknown command: $COMMAND" >&2
    usage >&2
    exit 2
    ;;
esac
