#!/usr/bin/env bash
set -e

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/macaron"
SERVICES_DIR="$CONFIG_DIR/services"

run_check() {
  if [ -x "$1" ]; then
    "$1"
  else
    bash "$1"
  fi
}

doctor() {
  local failed=0
  local found=0
  local service_dir
  local service_check

  if ! command -v tailscale >/dev/null 2>&1; then
    echo "😵 Tailscale: not installed or not on PATH"
    failed=1
  elif tailscale status >/dev/null 2>&1; then
    echo "✅ Tailscale: running"
  else
    echo "😵 Tailscale: stopped or needs login"
    failed=1
  fi

  echo
  echo "🔍 Checking services..."
  if [ ! -d "$SERVICES_DIR" ]; then
    echo "  - no services configured ($SERVICES_DIR)"
  else
    for service_dir in "$SERVICES_DIR"/*; do
      [ -d "$service_dir" ] || continue
      service_check="$service_dir/doctor"
      [ -f "$service_check" ] || continue
      found=1

      if run_check "$service_check"; then
        echo "  - $(basename "$service_dir"): ok"
      else
        echo "  - $(basename "$service_dir"): not ok"
        failed=1
      fi
    done
  fi

  if [ "$found" -eq 0 ] && [ -d "$SERVICES_DIR" ]; then
    echo "  - no service checks found"
  fi

  if [ "$failed" -eq 0 ]; then
    echo
    echo "✅ Doctor: all checks passed"
  else
    echo
    echo "😵 Doctor: one or more checks failed"
  fi

  return "$failed"
}

install() {
  REPO=$1
  NAME=$(basename "$REPO")

  # If NAME starts with macaron-service- , strip it off
  if [[ "$NAME" == macaron-service-* ]]; then
    NAME="${NAME#macaron-service-}"
  fi

  echo "📦 Installing from $REPO..."
  git clone "$REPO" "$SERVICES_DIR/$NAME"
  echo "✅ Installed from $REPO"
}

update() {
  echo "🔄 Updating..."
  for service_dir in "$SERVICES_DIR"/*; do
    if [ -d "$service_dir" ]; then
      cd "$service_dir"
      git pull &>/dev/null
      echo "✅ $(basename "$service_dir") updated ($(git rev-parse --short HEAD))"
    fi
  done
  echo "✅ Update complete"
}

start() {
  sudo -v

  OLD_REMOTE_LOGIN=$(sudo systemsetup -getremotelogin | awk '{print tolower($3)}')
  if pmset -g | grep -q 'SleepDisabled.*1'; then
    OLD_DISABLE_SLEEP=1
  else
    OLD_DISABLE_SLEEP=0
  fi

  if tailscale status >/dev/null 2>&1; then
    OLD_TAILSCALE_RUNNING=1
  else
    OLD_TAILSCALE_RUNNING=0
  fi

  cleanup() {
    echo
    echo "🔙 Restoring previous settings..."

    sudo systemsetup -setremotelogin "$OLD_REMOTE_LOGIN" >/dev/null
    sudo pmset -a disablesleep "$OLD_DISABLE_SLEEP"

    if [ "$OLD_TAILSCALE_RUNNING" -eq 1 ]; then
      tailscale up
    else
      tailscale down
    fi
  }

  trap cleanup EXIT
  trap 'exit 0' INT TERM

  sudo systemsetup -setremotelogin on >/dev/null
  echo "✅ Remote Login enabled"
  sudo pmset -a disablesleep 1
  echo "✅ Sleep disabled"
  tailscale up
  echo "✅ Tailscale started"

  echo
  echo "🙈 Environment looks good! Now loading services"

  TAILSCALE_IP=$(tailscale ip -4 | head -n 1)
  PORT=49001
  LOGS=""

  for SERVICE_START in "$SERVICES_DIR"/*/start; do
    [ -x "$SERVICE_START" ] || continue

    SERVICE=$(basename "$(dirname "$SERVICE_START")")
    if MACARON_AVAILABLE_PORT="$PORT" "$SERVICE_START"; then
      echo "✅ $SERVICE started"
      LOGS="$LOGS   -> $SERVICE: http://$TAILSCALE_IP:$PORT\n"
    else
      echo "😵 Failed to start $SERVICE"
    fi
    PORT=$((PORT + 1))
  done

  echo
  echo "🏃 Everything looks good! Macaron is running..."
  echo "   -> Connect via SSH: ssh $(whoami)@$TAILSCALE_IP"
  printf '%b' "$LOGS"

  while true; do
    sleep 3600
  done
}

if [ "${1:-start}" = "doctor" ]; then
  doctor
elif [ "${1:-start}" = "install" ]; then
  install $2
elif [ "${1:-start}" = "update" ]; then
  update
else
  start
fi
