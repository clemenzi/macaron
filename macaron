#!/usr/bin/env bash
set -e

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/macaron"
SERVICES_DIR="$CONFIG_DIR/services"
MAX_OUTPUT_LINES=4

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  GRAY=$'\033[90m'
  GREEN=$'\033[32m'
  YELLOW=$'\033[33m'
  RED=$'\033[31m'
  DIM_GRAY=$'\033[2;90m'
  RESET=$'\033[0m'
else
  GRAY=""
  GREEN=""
  YELLOW=""
  RED=""
  DIM_GRAY=""
  RESET=""
fi

log() { printf '%s%s%s\n' "$GRAY" "$*" "$RESET"; }
log_success() { printf '%s%s%s\n' "$GREEN" "$*" "$RESET"; }
log_warn() { printf '%s%s%s\n' "$YELLOW" "$*" "$RESET"; }
log_error() { printf '%s%s%s\n' "$RED" "$*" "$RESET" >&2; }
log_script() { printf '%s%s%s\n' "$DIM_GRAY" "$*" "$RESET"; }

stream_output() {
  local line
  local line_count=0

  while IFS= read -r line || [ -n "$line" ]; do
    line_count=$((line_count + 1))
    if [ "$line_count" -le "$MAX_OUTPUT_LINES" ]; then
      log_script "│ $line"
    fi
  done
}

run_check() {
  local script=$1
  local label=${2:-script}
  local status

  log_script "╭─ $label logs"
  if [ -x "$script" ]; then
    "$script" 2>&1 | stream_output
    status=${PIPESTATUS[0]}
  else
    bash "$script" 2>&1 | stream_output
    status=${PIPESTATUS[0]}
  fi
  log_script "╰─ logs end"
  return "$status"
}

usage() {
  cat <<EOF
Usage:
  macaron [start]                        | Start macaron
  macaron doctor                         | Check if everything is correctly configured and working
  macaron install [options] <repository> | Install a service from a Git repository
  macaron update                         | Update all services
  macaron delete <service>               | Delete a service
  macaron list                           | List all services
  macaron help                           | Show this help
  macaron self-update                    | Update macaron to the latest version
EOF
}

install_usage() {
  cat <<EOF
Usage: macaron install [options] <repository>

Options:
  --name <name>       Name of the service directory
  --branch <branch>   Clone a specific branch
  --skip-build        Do not run the service build script
  --skip-doctor       Do not run the service doctor
  -y, --yes           Automatically confirm the build script
  -h, --help          Show this help
EOF
}

doctor() {
  local failed=0
  local found=0
  local service_dir
  local service_check

  if ! command -v tailscale >/dev/null 2>&1; then
    log_error "😵 Tailscale: not installed or not on PATH"
    failed=1
  elif tailscale status >/dev/null 2>&1; then
    log_success "✅ Tailscale: running"
  else
    log_error "😵 Tailscale: stopped or needs login"
    failed=1
  fi

  echo
  log "🔍 Checking services..."
  if [ ! -d "$SERVICES_DIR" ]; then
    log "  - no services configured ($SERVICES_DIR)"
  else
    for service_dir in "$SERVICES_DIR"/*; do
      [ -d "$service_dir" ] || continue
      service_check="$service_dir/.macaron/doctor"
      [ -f "$service_check" ] || continue
      found=1

      if run_check "$service_check" "$(basename "$service_dir") · doctor"; then
        log_success "  - $(basename "$service_dir"): ok"
      else
        log_error "  - $(basename "$service_dir"): not ok"
        failed=1
      fi
    done
  fi

  if [ "$found" -eq 0 ] && [ -d "$SERVICES_DIR" ]; then
    log "  - no service checks found"
  fi

  if [ "$failed" -eq 0 ]; then
    echo
    log_success "✅ Doctor: all checks passed"
  else
    echo
    log_error "😵 Doctor: one or more checks failed"
  fi

  return "$failed"
}

install() {
  local repo=""
  local name=""
  local branch=""
  local skip_build=0
  local skip_doctor=0
  local yes=0
  local arg

  while [ "$#" -gt 0 ]; do
    arg=$1
    case "$arg" in
      --name)
        [ "$#" -ge 2 ] || { echo "Missing value for --name" >&2; install_usage >&2; return 2; }
        name=$2
        shift 2
        ;;
      --branch)
        [ "$#" -ge 2 ] || { echo "Missing value for --branch" >&2; install_usage >&2; return 2; }
        branch=$2
        shift 2
        ;;
      --skip-build)
        skip_build=1
        shift
        ;;
      --skip-doctor)
        skip_doctor=1
        shift
        ;;
      -y|--yes)
        yes=1
        shift
        ;;
      -h|--help)
        install_usage
        return 0
        ;;
      --)
        shift
        [ "$#" -gt 0 ] || { echo "Missing repository" >&2; install_usage >&2; return 2; }
        repo=$1
        shift
        ;;
      -* )
        echo "Unknown install option: $arg" >&2
        install_usage >&2
        return 2
        ;;
      *)
        [ -z "$repo" ] || { echo "Only one repository can be installed at a time" >&2; install_usage >&2; return 2; }
        repo=$arg
        shift
        ;;
    esac
  done

  [ -n "$repo" ] || { echo "Missing repository" >&2; install_usage >&2; return 2; }

  if [ -z "$name" ]; then
    name=$(basename "$repo")
    name="${name%.git}"
  fi

  log "📦 Installing from $repo..."

  # If NAME starts with macaron-service- , strip it off
  if [[ "$name" == macaron-service-* ]]; then
    name="${name#macaron-service-}"
    log "ℹ️  Stripped macaron-service- prefix from name"
  fi

  mkdir -p "$SERVICES_DIR"
  if [ -n "$branch" ]; then
    git clone --quiet --branch "$branch" "$repo" "$SERVICES_DIR/$name"
  else
    git clone --quiet "$repo" "$SERVICES_DIR/$name"
  fi

  # If the service has a .macaron/build script, run it (after confirmation)
  if [ "$skip_build" -eq 0 ]; then
    if [ -f "$SERVICES_DIR/$name/.macaron/build" ]; then
      if [ "$yes" -eq 1 ]; then
        log "🔨 Building $name..."
        run_check "$SERVICES_DIR/$name/.macaron/build" "$name · build"
      else
        echo -n "ℹ️  $name has a build script. Run it? [y/N] "
        read -r answer
        if [[ "$answer" == [Yy]* ]]; then
          log "🔨 Building $name..."
          run_check "$SERVICES_DIR/$name/.macaron/build" "$name · build"
        else
          log_warn "⚠️  Build skipped; the service may not work correctly"
        fi
      fi
    fi
  else
    log "ℹ️  Build skipped"
  fi

  # After the build script, run the doctor if the service has one
  if [ "$skip_doctor" -eq 0 ]; then
    if [ -f "$SERVICES_DIR/$name/.macaron/doctor" ]; then
      if run_check "$SERVICES_DIR/$name/.macaron/doctor" "$name · doctor"; then
        log_success "✅ Doctor passed"
      else
        log_error "😵 Doctor failed; run 'macaron doctor' for details"
      fi
    fi
  else
    log "ℹ️  Doctor skipped"
  fi

  log_success "✅ Installed from $repo"
}

delete() {
  [ "$#" -eq 1 ] || { echo "Usage: macaron delete <service>" >&2; return 2; }
  NAME=$(basename "$1")
  log "🗑️  Deleting $NAME..."
  if [ -d "$SERVICES_DIR/$NAME" ]; then
    rm -rf "$SERVICES_DIR/$NAME"
    log_success "✅ $NAME deleted"
  else
    log "ℹ️  $NAME is not installed"
  fi
}

update() {
  local service_dir
  local service_name
  local build_script

  log "🔄 Updating services..."
  for service_dir in "$SERVICES_DIR"/*; do
    if [ -d "$service_dir" ]; then
      cd "$service_dir"
      git pull --quiet

      service_name=$(basename "$service_dir")
      log_success "✅ $service_name updated ($(git rev-parse --short HEAD))"

      build_script="$service_dir/.macaron/build"
      if [ -f "$build_script" ]; then
        log "🔨 Building $service_name..."
        run_check "$build_script" "$service_name · build"
      fi
    fi
  done
  log_success "✅ Update complete"
}

list() {
  log "ℹ️  Installed services:"
  for service_dir in "$SERVICES_DIR"/*; do
    if [ -d "$service_dir" ]; then
      log "   - $(basename "$service_dir")"
    fi
  done
}

self-update() {
  sudo -v
  log "🔄 Downloading latest macaron installer..."
  curl -L https://raw.githubusercontent.com/clemenzi/macaron/refs/heads/main/install.sh | sudo bash
}

start() {
  sudo -v

  OLD_REMOTE_LOGIN=$(sudo systemsetup -getremotelogin | awk '{print tolower($3)}')
  if pmset -g | grep -q 'SleepDisabled.*1'; then
    OLD_DISABLE_SLEEP=1
  else
    OLD_DISABLE_SLEEP=0
  fi

  if tailscale status >/dev/null 2>&1; then
    OLD_TAILSCALE_RUNNING=1
  else
    OLD_TAILSCALE_RUNNING=0
  fi

  cleanup() {
    local service_dir
    local service_name
    local service_cleanup

    echo
    log "🧹 Cleaning up services..."

    if [ -d "$SERVICES_DIR" ]; then
      for service_dir in "$SERVICES_DIR"/*; do
        [ -d "$service_dir" ] || continue
        service_cleanup="$service_dir/.macaron/cleanup"
        [ -f "$service_cleanup" ] || continue

        service_name=$(basename "$service_dir")
        if run_check "$service_cleanup" "$service_name · cleanup"; then
          log_success "✅ $service_name cleaned up"
        else
          log_error "😵 Failed to clean up $service_name"
        fi
      done
    fi

    log "🔙 Restoring previous settings..."

    sudo systemsetup -setremotelogin "$OLD_REMOTE_LOGIN" >/dev/null
    sudo pmset -a disablesleep "$OLD_DISABLE_SLEEP"

    if [ "$OLD_TAILSCALE_RUNNING" -eq 1 ]; then
      tailscale up
    else
      tailscale down
    fi
  }

  trap cleanup EXIT
  trap 'exit 0' INT TERM

  sudo systemsetup -setremotelogin on >/dev/null
  log_success "✅ Remote Login enabled"
  sudo pmset -a disablesleep 1
  log_success "✅ Sleep disabled"
  tailscale up
  log_success "✅ Tailscale started"

  echo
  log "🙈 Environment ready; loading services..."

  TAILSCALE_IP=$(tailscale ip -4 | head -n 1)
  PORT=49001
  LOGS=""
  FOUND_SERVICES=0

  if [ -d "$SERVICES_DIR" ]; then
    for SERVICE_DIR in "$SERVICES_DIR"/*; do
      [ -d "$SERVICE_DIR" ] || continue
      SERVICE_START="$SERVICE_DIR/.macaron/start"
      [ -f "$SERVICE_START" ] || continue
      FOUND_SERVICES=1

      SERVICE=$(basename "$SERVICE_DIR")
      if MACARON_AVAILABLE_PORT="$PORT" run_check "$SERVICE_START" "$SERVICE · start"; then
        log_success "✅ $SERVICE started"
        LOGS="$LOGS   -> $SERVICE: http://$TAILSCALE_IP:$PORT\n"
      else
        log_error "😵 Failed to start $SERVICE"
      fi
      PORT=$((PORT + 1))
    done
  fi

  if [ "$FOUND_SERVICES" -eq 0 ]; then
    log_warn "⚠️  No services found in $SERVICES_DIR"
  fi

  echo
  log_success "🏃 Macaron is running"
  log "   → SSH: ssh $(whoami)@$TAILSCALE_IP"
  printf '%b' "$GRAY$LOGS$RESET"

  while true; do
    sleep 3600
  done
}

COMMAND="${1:-start}"
[ "$#" -eq 0 ] || shift

case "$COMMAND" in
  doctor)
    [ "$#" -eq 0 ] || { echo "Usage: macaron doctor" >&2; exit 2; }
    doctor
    ;;
  install)
    install "$@"
    ;;
  update)
    [ "$#" -eq 0 ] || { echo "Usage: macaron update" >&2; exit 2; }
    update
    ;;
  delete)
    delete "$@"
    ;;
  list)
    list
    ;;
  start)
    [ "$#" -eq 0 ] || { echo "Usage: macaron start" >&2; exit 2; }
    start
    ;;
  help|--help|-h)
    usage
    ;;
  self-update)
    [ "$#" -eq 0 ] || { echo "Usage: macaron self-update" >&2; exit 2; }
    self-update
    ;;
  *)
    echo "Unknown command: $COMMAND" >&2
    usage >&2
    exit 2
    ;;
esac
