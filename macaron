#!/usr/bin/env bash
set -e

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/macaron"
SERVICES_DIR="$CONFIG_DIR/services"
DISABLED_SERVICES_DIR="$CONFIG_DIR/services-disabled"
ACTIVE_SERVICES_FILE="$CONFIG_DIR/active-services.json"
MAX_OUTPUT_LINES=4

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  WHITE=$'\033[37m'
  DIM_GRAY=$'\033[2;90m'
  DIM_GRAY_ITALIC=$'\033[2;3;90m'
  RESET=$'\033[0m'
else
  WHITE=""
  DIM_GRAY=""
  DIM_GRAY_ITALIC=""
  RESET=""
fi

log() { printf '%s%s%s\n' "$WHITE" "$*" "$RESET"; }
log_success() { log "$@"; }
log_warn() { log "$@"; }
log_error() { printf '%s%s%s\n' "$WHITE" "$*" "$RESET" >&2; }
log_script() { printf '%s%s%s\n' "$DIM_GRAY" "$*" "$RESET"; }
log_empty_script() { printf '%s%s%s\n' "$DIM_GRAY_ITALIC" "$*" "$RESET"; }

json_escape() {
  local value=$1

  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  value=${value//$'\t'/\\t}
  printf '%s' "$value"
}

write_active_services_file() {
  local separator=""
  local index
  local service_name
  local temp_file

  mkdir -p "$CONFIG_DIR"
  temp_file=$(mktemp "$CONFIG_DIR/.active-services.XXXXXX")
  {
    printf '[\n'
    for index in "${!ACTIVE_SERVICE_NAMES[@]}"; do
      service_name=$(json_escape "${ACTIVE_SERVICE_NAMES[$index]}")
      printf '%s  {"name":"%s","port":%s}' \
        "$separator" "$service_name" "${ACTIVE_SERVICE_PORTS[$index]}"
      separator=$',\n'
    done
    printf '\n]\n'
  } > "$temp_file"
  mv "$temp_file" "$ACTIVE_SERVICES_FILE"
}

stream_output() {
  local line
  local line_count=0

  while IFS= read -r line || [ -n "$line" ]; do
    line_count=$((line_count + 1))
    if [ "$line_count" -le "$MAX_OUTPUT_LINES" ]; then
      log_script "│ $line"
    fi
  done

  if [ "$line_count" -eq 0 ]; then
    log_empty_script "│ no output from script"
  fi
}

run_script() {
  local script=$1
  local service_dir

  service_dir=$(dirname "$(dirname "$script")")

  (
    cd "$service_dir" || exit 1
    if [ -x "$script" ]; then
      "$script"
    else
      bash "$script"
    fi
  )
}

start_service() {
  local service_start=$1
  local available_port=$2
  local service_dir

  service_dir=$(dirname "$(dirname "$service_start")")

  cd "$service_dir" || exit 1
  export MACARON_AVAILABLE_PORT="$available_port"
  if [ -x "$service_start" ]; then
    exec "$service_start"
  else
    exec bash "$service_start"
  fi
}

run_check() {
  local script=$1
  local label=${2:-script}
  local status

  log_script "╭─ $label logs"
  run_script "$script" 2>&1 | stream_output
  status=${PIPESTATUS[0]}
  log_script "╰─ logs end"
  return "$status"
}

usage() {
  cat <<EOF
Usage:
  macaron [start]                        | Start macaron
  macaron doctor                         | Check if everything is correctly configured and working
  macaron install [options] <source>     | Install a service from a Git repository or local directory
  macaron update                         | Update all services
  macaron disable <service>              | Disable a service
  macaron enable <service>               | Enable a service
  macaron delete <service>               | Delete a service
  macaron list                           | List all services
  macaron help                           | Show this help
  macaron self-update                    | Update macaron to the latest version
EOF
}

install_usage() {
  cat <<EOF
Usage: macaron install [options] <source>

Options:
  --name <name>       Name of the service directory
  --branch <branch>   Clone a specific branch (Git repositories only)
  --skip-build        Do not run the service build script
  --skip-doctor       Do not run the service doctor
  -y, --yes           Automatically confirm the build script
  -h, --help          Show this help
EOF
}

doctor() {
  local failed=0
  local found=0
  local service_dir
  local service_check
  local tailscale_status

  if ! command -v tailscale >/dev/null 2>&1; then
    log_error "😵 Tailscale: not installed or not on PATH"
    failed=1
  elif ! tailscale_status=$(tailscale status --json 2>/dev/null); then
    log_error "😵 Tailscale: unable to determine login status"
    failed=1
  elif printf '%s\n' "$tailscale_status" | grep -q '"BackendState": "NeedsLogin"'; then
    log_error "😵 Tailscale: not logged in"
    failed=1
  else
    log_success "✅ Tailscale: logged in"
  fi

  echo
  log "🔍 Checking services..."
  if [ ! -d "$SERVICES_DIR" ]; then
    log "  - no services configured ($SERVICES_DIR)"
  else
    for service_dir in "$SERVICES_DIR"/*; do
      [ -d "$service_dir" ] || continue
      service_check="$service_dir/.macaron/doctor"
      [ -f "$service_check" ] || continue
      found=1

      if run_check "$service_check" "$(basename "$service_dir") · doctor"; then
        log_success "  - $(basename "$service_dir"): ok"
      else
        log_error "  - $(basename "$service_dir"): not ok"
        failed=1
      fi
    done
  fi

  if [ "$found" -eq 0 ] && [ -d "$SERVICES_DIR" ]; then
    log "  - no service checks found"
  fi

  if [ "$failed" -eq 0 ]; then
    echo
    log_success "✅ Doctor: all checks passed"
  else
    echo
    log_error "😵 Doctor: one or more checks failed"
  fi

  return "$failed"
}

install() {
  local source=""
  local name=""
  local branch=""
  local skip_build=0
  local skip_doctor=0
  local yes=0
  local arg

  while [ "$#" -gt 0 ]; do
    arg=$1
    case "$arg" in
      --name)
        [ "$#" -ge 2 ] || { echo "Missing value for --name" >&2; install_usage >&2; return 2; }
        name=$2
        shift 2
        ;;
      --branch)
        [ "$#" -ge 2 ] || { echo "Missing value for --branch" >&2; install_usage >&2; return 2; }
        branch=$2
        shift 2
        ;;
      --skip-build)
        skip_build=1
        shift
        ;;
      --skip-doctor)
        skip_doctor=1
        shift
        ;;
      -y|--yes)
        yes=1
        shift
        ;;
      -h|--help)
        install_usage
        return 0
        ;;
      --)
        shift
        [ "$#" -gt 0 ] || { echo "Missing source" >&2; install_usage >&2; return 2; }
        source=$1
        shift
        ;;
      -* )
        echo "Unknown install option: $arg" >&2
        install_usage >&2
        return 2
        ;;
      *)
        [ -z "$source" ] || { echo "Only one source can be installed at a time" >&2; install_usage >&2; return 2; }
        source=$arg
        shift
        ;;
    esac
  done

  [ -n "$source" ] || { echo "Missing source" >&2; install_usage >&2; return 2; }

  if [ -z "$name" ]; then
    name=$(basename "$source")
    name="${name%.git}"
  fi

  log "📦 Installing from $source..."

  # If NAME starts with macaron-service- , strip it off
  if [[ "$name" == macaron-service-* ]]; then
    name="${name#macaron-service-}"
    log "ℹ️  Stripped macaron-service- prefix from name"
  fi

  mkdir -p "$SERVICES_DIR"
  if [ -e "$SERVICES_DIR/$name" ]; then
    log_error "😵 Cannot install $name: a service with that name already exists"
    return 1
  fi

  if [ -d "$source" ]; then
    if [ -n "$branch" ]; then
      log_error "😵 --branch cannot be used with a local directory"
      return 2
    fi
    cp -R "$source" "$SERVICES_DIR/$name"
  elif [ -n "$branch" ]; then
    git clone --quiet --branch "$branch" "$source" "$SERVICES_DIR/$name"
  else
    git clone --quiet "$source" "$SERVICES_DIR/$name"
  fi

  # If the service has a .macaron/build script, run it (after confirmation)
  if [ "$skip_build" -eq 0 ]; then
    if [ -f "$SERVICES_DIR/$name/.macaron/build" ]; then
      if [ "$yes" -eq 1 ]; then
        log "🔨 Building $name..."
        run_check "$SERVICES_DIR/$name/.macaron/build" "$name · build"
      else
        echo -n "ℹ️  $name has a build script. Run it? [y/N] "
        read -r answer
        if [[ "$answer" == [Yy]* ]]; then
          log "🔨 Building $name..."
          run_check "$SERVICES_DIR/$name/.macaron/build" "$name · build"
        else
          log_warn "⚠️  Build skipped; the service may not work correctly"
        fi
      fi
    fi
  else
    log "ℹ️  Build skipped"
  fi

  # After the build script, run the doctor if the service has one
  if [ "$skip_doctor" -eq 0 ]; then
    if [ -f "$SERVICES_DIR/$name/.macaron/doctor" ]; then
      if run_check "$SERVICES_DIR/$name/.macaron/doctor" "$name · doctor"; then
        log_success "✅ Doctor passed"
      else
        log_error "😵 Doctor failed; run 'macaron doctor' for details"
      fi
    fi
  else
    log "ℹ️  Doctor skipped"
  fi

  log_success "✅ Installed from $source"
}

delete() {
  local name
  local enabled_service
  local disabled_service

  [ "$#" -eq 1 ] || { echo "Usage: macaron delete <service>" >&2; return 2; }
  name=$(basename "$1")
  enabled_service="$SERVICES_DIR/$name"
  disabled_service="$DISABLED_SERVICES_DIR/$name"

  if [ -d "$enabled_service" ] && [ -d "$disabled_service" ]; then
    log_error "😵 Cannot delete $name: it exists in both enabled and disabled services"
    return 1
  fi

  log "🗑️  Deleting $name..."
  if [ -d "$enabled_service" ]; then
    rm -rf "$enabled_service"
    log_success "✅ $name deleted"
  elif [ -d "$disabled_service" ]; then
    rm -rf "$disabled_service"
    log_success "✅ $name deleted"
  else
    log "ℹ️  $name is not installed"
  fi
}

disable() {
  local name

  [ "$#" -eq 1 ] || { echo "Usage: macaron disable <service>" >&2; return 2; }
  name=$(basename "$1")

  if [ ! -d "$SERVICES_DIR/$name" ]; then
    log "ℹ️  $name is not enabled"
    return 0
  fi

  if [ -e "$DISABLED_SERVICES_DIR/$name" ]; then
    log_error "😵 Cannot disable $name: a disabled service with that name already exists"
    return 1
  fi

  mkdir -p "$DISABLED_SERVICES_DIR"
  mv "$SERVICES_DIR/$name" "$DISABLED_SERVICES_DIR/$name"
  log_success "✅ $name disabled"
}

enable() {
  local name

  [ "$#" -eq 1 ] || { echo "Usage: macaron enable <service>" >&2; return 2; }
  name=$(basename "$1")

  if [ ! -d "$DISABLED_SERVICES_DIR/$name" ]; then
    log "ℹ️  $name is not disabled"
    return 0
  fi

  if [ -e "$SERVICES_DIR/$name" ]; then
    log_error "😵 Cannot enable $name: an enabled service with that name already exists"
    return 1
  fi

  mkdir -p "$SERVICES_DIR"
  mv "$DISABLED_SERVICES_DIR/$name" "$SERVICES_DIR/$name"
  log_success "✅ $name enabled"
}

update() {
  local service_dir
  local service_name
  local build_script

  log "🔄 Updating services..."
  for service_dir in "$SERVICES_DIR"/*; do
    if [ -d "$service_dir" ]; then
      service_name=$(basename "$service_dir")
      if ! git -C "$service_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        log "ℹ️  $service_name was installed from a local directory; update skipped"
        continue
      fi

      git -C "$service_dir" pull --quiet
      log_success "✅ $service_name updated ($(git -C "$service_dir" rev-parse --short HEAD))"

      build_script="$service_dir/.macaron/build"
      if [ -f "$build_script" ]; then
        log "🔨 Building $service_name..."
        run_check "$build_script" "$service_name · build"
      fi
    fi
  done
  log_success "✅ Update complete"
}

list() {
  local service_dir

  log "ℹ️  Installed services:"
  for service_dir in "$SERVICES_DIR"/*; do
    if [ -d "$service_dir" ]; then
      log "   - $(basename "$service_dir")"
    fi
  done

  log "ℹ️  Disabled services:"
  for service_dir in "$DISABLED_SERVICES_DIR"/*; do
    if [ -d "$service_dir" ]; then
      log "   - $(basename "$service_dir")"
    fi
  done
}

self-update() {
  sudo -v
  log "🔄 Downloading latest macaron installer..."
  curl -L https://raw.githubusercontent.com/clemenzi/macaron/refs/heads/main/install.sh | sudo bash
}

start() {
  local service_dir
  local service_name
  local service_cleanup
  local service_start
  local port
  local pid
  local status
  local index
  local tailscale_ip
  local service_log
  local logs=""
  local found_services=0

  sudo -v

  OLD_REMOTE_LOGIN=$(sudo systemsetup -getremotelogin | awk '{print tolower($3)}')
  if pmset -g | grep -q 'SleepDisabled.*1'; then
    OLD_DISABLE_SLEEP=1
  else
    OLD_DISABLE_SLEEP=0
  fi

  if tailscale status >/dev/null 2>&1; then
    OLD_TAILSCALE_RUNNING=1
  else
    OLD_TAILSCALE_RUNNING=0
  fi

  SERVICE_PIDS=()
  SERVICE_NAMES=()
  SERVICE_PORTS=()
  ACTIVE_SERVICE_NAMES=()
  ACTIVE_SERVICE_PORTS=()
  SERVICE_LOG_PIDS=()
  SERVICE_LOG_DIR=""

  port_is_available() {
    ! lsof -nP -iTCP:"$1" >/dev/null 2>&1
  }

  stream_service_output() {
    local service_name=$1
    local output=$2
    local line

    while IFS= read -r line || [ -n "$line" ]; do
      log_script "🪵 ($service_name) LOG $line"
    done < "$output"
  }

  stop_services() {
    local service_pid
    local log_pid

    if [ "${#SERVICE_PIDS[@]}" -gt 0 ]; then
      log "🛑 Stopping services..."
      for service_pid in "${SERVICE_PIDS[@]}"; do
        kill -TERM "$service_pid" 2>/dev/null || true
      done

      # Give foreground service processes a moment to shut down cleanly.
      sleep 1
      for service_pid in "${SERVICE_PIDS[@]}"; do
        if kill -0 "$service_pid" 2>/dev/null; then
          log_warn "⚠️  Service process $service_pid did not stop gracefully; stopping it"
          kill -KILL "$service_pid" 2>/dev/null || true
        fi
        wait "$service_pid" 2>/dev/null || true
      done
    fi

    for log_pid in "${SERVICE_LOG_PIDS[@]}"; do
      kill -TERM "$log_pid" 2>/dev/null || true
      wait "$log_pid" 2>/dev/null || true
    done
    if [ -n "$SERVICE_LOG_DIR" ]; then
      rm -rf "$SERVICE_LOG_DIR"
    fi
    rm -f "$ACTIVE_SERVICES_FILE"
  }

  cleanup() {
    trap - EXIT INT TERM
    set +e

    echo
    stop_services
    log "🧹 Cleaning up services..."

    if [ -d "$SERVICES_DIR" ]; then
      for service_dir in "$SERVICES_DIR"/*; do
        [ -d "$service_dir" ] || continue
        service_cleanup="$service_dir/.macaron/cleanup"
        [ -f "$service_cleanup" ] || continue

        service_name=$(basename "$service_dir")
        if run_check "$service_cleanup" "$service_name · cleanup"; then
          log_success "✅ $service_name cleaned up"
        else
          log_error "😵 Failed to clean up $service_name"
        fi
      done
    fi

    log "🔙 Restoring previous settings..."

    if ! sudo systemsetup -setremotelogin "$OLD_REMOTE_LOGIN" >/dev/null; then
      log_error "😵 Failed to restore Remote Login"
    fi
    if ! sudo pmset -a disablesleep "$OLD_DISABLE_SLEEP"; then
      log_error "😵 Failed to restore sleep settings"
    fi

    if [ "$OLD_TAILSCALE_RUNNING" -eq 1 ]; then
      if ! tailscale up; then
        log_error "😵 Failed to restore Tailscale"
      fi
    else
      if ! tailscale down; then
        log_error "😵 Failed to restore Tailscale"
      fi
    fi
  }

  trap cleanup EXIT
  trap 'exit 0' INT TERM

  SERVICE_LOG_DIR=$(mktemp -d "${TMPDIR:-/tmp}/macaron.XXXXXX")

  sudo systemsetup -setremotelogin on >/dev/null
  log_success "✅ Remote Login enabled"
  sudo pmset -a disablesleep 1
  log_success "✅ Sleep disabled"
  tailscale up
  log_success "✅ Tailscale started"

  echo
  log "🙈 Environment ready; loading services..."

  tailscale_ip=$(tailscale ip -4 | head -n 1)
  port=49001

  if [ -d "$SERVICES_DIR" ]; then
    for service_dir in "$SERVICES_DIR"/*; do
      [ -d "$service_dir" ] || continue
      service_start="$service_dir/.macaron/start"
      [ -f "$service_start" ] || continue
      found_services=1

      while ! port_is_available "$port"; do
        port=$((port + 1))
      done

      service_name=$(basename "$service_dir")
      service_log="$SERVICE_LOG_DIR/$service_name"
      mkfifo "$service_log"
      stream_service_output "$service_name" "$service_log" &
      SERVICE_LOG_PIDS[${#SERVICE_LOG_PIDS[@]}]=$!
      start_service "$service_start" "$port" > "$service_log" 2>&1 &
      pid=$!
      SERVICE_PIDS[${#SERVICE_PIDS[@]}]=$pid
      SERVICE_NAMES[${#SERVICE_NAMES[@]}]=$service_name
      SERVICE_PORTS[${#SERVICE_PORTS[@]}]=$port
      port=$((port + 1))
    done
  fi

  # A foreground start script should remain running. Let immediately failing
  # processes report their exit status before announcing successful startup.
  sleep 1
  for index in "${!SERVICE_PIDS[@]}"; do
    pid=${SERVICE_PIDS[$index]}
    service_name=${SERVICE_NAMES[$index]}
    if ! kill -0 "$pid" 2>/dev/null; then
      if wait "$pid"; then
        log_error "😵 $service_name exited immediately; .macaron/start must keep the service in the foreground"
      else
        status=$?
        log_error "😵 Failed to start $service_name (exit $status)"
      fi
    else
      log_success "✅ $service_name started"
      ACTIVE_SERVICE_NAMES[${#ACTIVE_SERVICE_NAMES[@]}]=$service_name
      ACTIVE_SERVICE_PORTS[${#ACTIVE_SERVICE_PORTS[@]}]=${SERVICE_PORTS[$index]}
      logs="$logs   -> $service_name: http://$tailscale_ip:${SERVICE_PORTS[$index]}\n"
    fi
  done

  write_active_services_file

  if [ "$found_services" -eq 0 ]; then
    log_warn "⚠️  No services found in $SERVICES_DIR"
  fi

  echo
  log_success "🏃 Macaron is running"
  log "   → SSH: ssh $(whoami)@$tailscale_ip"
  printf '%b' "$WHITE$logs$RESET"

  while true; do
    sleep 3600
  done
}

COMMAND="${1:-start}"
[ "$#" -eq 0 ] || shift

case "$COMMAND" in
  doctor)
    [ "$#" -eq 0 ] || { echo "Usage: macaron doctor" >&2; exit 2; }
    doctor
    ;;
  install)
    install "$@"
    ;;
  update)
    [ "$#" -eq 0 ] || { echo "Usage: macaron update" >&2; exit 2; }
    update
    ;;
  delete)
    delete "$@"
    ;;
  disable)
    disable "$@"
    ;;
  enable)
    enable "$@"
    ;;
  list)
    list
    ;;
  start)
    [ "$#" -eq 0 ] || { echo "Usage: macaron start" >&2; exit 2; }
    start
    ;;
  help|--help|-h)
    usage
    ;;
  self-update)
    [ "$#" -eq 0 ] || { echo "Usage: macaron self-update" >&2; exit 2; }
    self-update
    ;;
  *)
    echo "Unknown command: $COMMAND" >&2
    usage >&2
    exit 2
    ;;
esac
